<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Atrox" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        
        <!-- Add the animated logo we just created -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_logo</item>
        <!-- Duration should match our longest animation (approx 850ms, so 1000ms is safe) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        
        <!-- Set the theme of the Activity that directly follows your splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.Atrox</item>
    </style>
</resources>